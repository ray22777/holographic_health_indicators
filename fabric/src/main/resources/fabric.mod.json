{
  "schemaVersion": 1,
  "id": "holographic_health_indicators",
  "version": "${version}",
  "name": "Holographic Health Indicators",
  "description": "Add client-sided, highly customizable, health indicators for entities.",
  "authors": [
    "ray"
  ],
  "contact": {
    "sources": "https://github.com/ray22777/holographic_health_indicators"
  },
  "license": "MIT",
  "icon": "assets/holographic_health_indicators/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.ray.healthindicators.fabric.HolographicDamageIndicator"
    ],
    "client": [
      "net.ray.healthindicators.fabric.client.HolographicIndicatorClient"
    ],
    "modmenu": [
      "net.ray.healthindicators.fabric.ModMenuIntegration"
    ]
  },
  "mixins": [
    "holographic_health_indicators.mixins.json"
  ],
  "depends": {
    "fabricloader": "*",
    "minecraft": ">=1.20",
    "java": ">=17",
    "fabric-api": "*",
    "cloth-config": "*",
    "hologram_api": ">=1.1.0"
  },
  "suggests": {
    "modmenu": "*"
  }
}
